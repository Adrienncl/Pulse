    zap: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>,
    download: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>,
    refresh: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>,
    filter: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>,
    menu: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>,
    x: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>,
    clock: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>,
    users: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>,
    star: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>,
    globe: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>,
    creditCard: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>,
    sparkles: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>,
    chart: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>,
    spinner: <svg className="animate-spin" width={size} height={size} viewBox="0 0 24 24" fill="none"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"/><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>,
    chevronDown: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="6 9 12 15 18 9"/></svg>,
    externalLink: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>,
    save: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>,
    copy: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>,
    info: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>,
    alertCircle: <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>,
  }
  return <span className={`inline-flex items-center ${className}`}>{icons[name] || icons.info}</span>
}

/* ═══════════════════════════════════════════════════════════
   LOGO SVG
   ═══════════════════════════════════════════════════════════ */

const LogoSVG = ({ size = 36 }) => (
  <svg width={size} height={size} viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="logoGrad" x1="0" y1="0" x2="40" y2="40">
        <stop offset="0%" stopColor="#6366f1" />
        <stop offset="50%" stopColor="#8b5cf6" />
        <stop offset="100%" stopColor="#ec4899" />
      </linearGradient>
    </defs>
    <rect width="40" height="40" rx="12" fill="url(#logoGrad)" />
    <path d="M12 28L20 10L28 28" stroke="white" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" fill="none" />
    <circle cx="20" cy="18" r="3" fill="white" opacity="0.9" />
    <path d="M15 24h10" stroke="white" strokeWidth="2" strokeLinecap="round" opacity="0.7" />
  </svg>
)

/* ═══════════════════════════════════════════════════════════
   SHARED COMPONENTS
   ═══════════════════════════════════════════════════════════ */

// ─── Stat Card ───────────────────────────────────────────
function StatCard({ icon, label, value, color = 'blue', sub = null, trend = null }) {
  const colorMap = {
    blue: { bg: 'from-blue-500/15 to-blue-600/5', border: 'border-blue-500/20', iconBg: 'bg-blue-500/15', text: 'text-blue-400', trend: trend > 0 ? 'text-emerald-400' : 'text-red-400' },
    green: { bg: 'from-emerald-500/15 to-emerald-600/5', border: 'border-emerald-500/20', iconBg: 'bg-emerald-500/15', text: 'text-emerald-400', trend: trend > 0 ? 'text-emerald-400' : 'text-red-400' },
    purple: { bg: 'from-purple-500/15 to-purple-600/5', border: 'border-purple-500/20', iconBg: 'bg-purple-500/15', text: 'text-purple-400', trend: trend > 0 ? 'text-emerald-400' : 'text-red-400' },
    amber: { bg: 'from-amber-500/15 to-amber-600/5', border: 'border-amber-500/20', iconBg: 'bg-amber-500/15', text: 'text-amber-400', trend: trend > 0 ? 'text-emerald-400' : 'text-red-400' },
    cyan: { bg: 'from-cyan-500/15 to-cyan-600/5', border: 'border-cyan-500/20', iconBg: 'bg-cyan-500/15', text: 'text-cyan-400', trend: trend > 0 ? 'text-emerald-400' : 'text-red-400' },
  }
  const c = colorMap[color] || colorMap.blue
  return (
    <div className={`bg-gradient-to-br ${c.bg} border ${c.border} rounded-2xl p-5 transition-all duration-300 hover:scale-[1.02] hover:shadow-lg backdrop-blur-sm`}>
      <div className="flex items-center justify-between mb-3">
        <div className="flex items-center gap-3">
          <div className={`p-2.5 rounded-xl ${c.iconBg}`}>
            <span className={c.text}>{icon}</span>
          </div>
          <span className="text-sm text-gray-400 font-medium">{label}</span>
        </div>
        {trend !== null && (
          <span className={`text-xs font-semibold ${c.trend}`}>
            {trend > 0 ? '↑' : '↓'} {Math.abs(trend)}%
          </span>
        )}
      </div>
      <div className="text-2xl font-black tracking-tight text-white">{value}</div>
      {sub && <div className="text-xs text-gray-500 mt-1.5">{sub}</div>}
    </div>
  )
}

// ─── Progress Bar ────────────────────────────────────────
function ProgressBar({ percent, color = 'blue', size = 'sm', animated = false }) {
  const colors = {
    blue: 'from-blue-600 to-blue-400',
    green: 'from-emerald-600 to-emerald-400',
    purple: 'from-purple-600 to-purple-400',
    amber: 'from-amber-600 to-amber-400',
    red: 'from-red-600 to-red-400',
    cyan: 'from-cyan-600 to-cyan-400',
  }
  const heights = { xs: 'h-1', sm: 'h-1.5', md: 'h-2', lg: 'h-3' }
  return (
    <div className={`w-full bg-gray-700/40 rounded-full ${heights[size]} overflow-hidden`}>
      <div
        className={`${heights[size]} rounded-full bg-gradient-to-r ${colors[color] || colors.blue} transition-all duration-700 ease-out`}
        style={{ width: `${Math.min(100, Math.max(0, percent))}%`, animation: animated ? 'progressBar 1s ease-out' : undefined }}
      />
    </div>
  )
}

// ─── Status Badge ────────────────────────────────────────
function StatusBadge({ status, size = 'sm' }) {
  const styles = {
    new: 'bg-gray-500/15 text-gray-400 border-gray-500/20',
    analyzed: 'bg-blue-500/15 text-blue-400 border-blue-500/20',
    priced: 'bg-purple-500/15 text-purple-400 border-purple-500/20',
    checkout: 'bg-amber-500/15 text-amber-400 border-amber-500/20',
    paid: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/20',
    generating: 'bg-cyan-500/15 text-cyan-400 border-cyan-500/20',
    completed: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/20',
    active: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/20',
    idle: 'bg-gray-500/15 text-gray-400 border-gray-500/20',
    pending: 'bg-amber-500/15 text-amber-400 border-amber-500/20',
    failed: 'bg-red-500/15 text-red-400 border-red-500/20',
  }
  const sizes = {
    xs: 'text-[10px] px-2 py-0.5',
    sm: 'text-xs px-2.5 py-1',
    md: 'text-xs px-3 py-1.5',
  }
  return (
    <span className={`inline-flex items-center gap-1.5 font-semibold rounded-full border ${styles[status] || styles.new} ${sizes[size]}`}>
      <span className={`w-1.5 h-1.5 rounded-full ${status === 'completed' || status === 'paid' || status === 'active' ? 'bg-emerald-400' : status === 'pending' || status === 'checkout' ? 'bg-amber-400' : status === 'failed' ? 'bg-red-400' : 'bg-gray-400'}`} />
      {status.charAt(0).toUpperCase() + status.slice(1)}
    </span>
  )
}

// ─── Empty State ─────────────────────────────────────────
function EmptyState({ icon = 'package', title, description, actionLabel, onAction }) {
  return (
    <div className="flex flex-col items-center justify-center py-16 px-8 text-center animate-fadeIn">
      <div className="w-16 h-16 rounded-2xl bg-gray-800/50 border border-gray-700/50 flex items-center justify-center mb-4">
        <Icon name={icon} size={28} className="text-gray-500" />
      </div>
      <h3 className="text-lg font-bold text-gray-300 mb-2">{title}</h3>
      <p className="text-sm text-gray-500 max-w-md mb-6">{description}</p>
      {actionLabel && onAction && (
        <button onClick={onAction} className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold transition-all hover:scale-105 shadow-lg shadow-indigo-500/25">
          <Icon name="plus" size={16} />
          {actionLabel}
        </button>
      )}
    </div>
  )
}

// ─── Loading State ───────────────────────────────────────
function LoadingState({ message = 'Loading...' }) {
  return (
    <div className="flex items-center justify-center h-64">
      <div className="flex flex-col items-center gap-4">
        <div className="w-10 h-10 border-2 border-indigo-500/30 border-t-indigo-500 rounded-full animate-spin" />
        <span className="text-sm text-gray-400 font-medium">{message}</span>
      </div>
    </div>
  )
}

// ─── Error State ─────────────────────────────────────────
function ErrorState({ message, onRetry }) {
  return (
    <div className="flex flex-col items-center justify-center py-12 text-center animate-fadeIn">
      <div className="w-14 h-14 rounded-2xl bg-red-500/10 border border-red-500/20 flex items-center justify-center mb-4">
        <Icon name="alertCircle" size={28} className="text-red-400" />
      </div>
      <h3 className="text-lg font-bold text-gray-300 mb-2">Something went wrong</h3>
      <p className="text-sm text-gray-500 max-w-md mb-6">{message}</p>
      {onRetry && (
        <button onClick={onRetry} className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gray-800 hover:bg-gray-700 border border-gray-700 text-white text-sm font-medium transition-all">
          <Icon name="refresh" size={16} />
          Try Again
        </button>
      )}
    </div>
  )
}

// ─── Toggle Switch ───────────────────────────────────────
function ToggleSwitch({ active, onChange }) {
  return (
    <button onClick={() => onChange(!active)} className={`relative w-11 h-6 rounded-full transition-colors duration-200 ${active ? 'bg-indigo-600' : 'bg-gray-600'}`}>
      <span className={`absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full transition-transform duration-200 shadow-sm ${active ? 'translate-x-5' : ''}`} />
    </button>
  )
}

// ─── Sidebar ─────────────────────────────────────────────
function Sidebar({ currentPage, setCurrentPage, collapsed, setCollapsed }) {
  const navItems = [
    { id: 'dashboard', label: 'Dashboard', icon: 'dashboard' },
    { id: 'clients', label: 'Clients', icon: 'clients' },
    { id: 'generate', label: 'Generate', icon: 'generate' },
    { id: 'demo', label: 'Live Demo', icon: 'demo', highlight: true },
    { id: 'settings', label: 'Settings', icon: 'settings' },
  ]

  return (
    <aside className={`${collapsed ? 'w-[72px]' : 'w-64'} bg-gray-950/80 backdrop-blur-xl border-r border-gray-800/60 flex flex-col transition-all duration-300 relative z-20 h-screen sticky top-0`}>
      {/* Logo */}
      <div className="p-5 border-b border-gray-800/60">
        <div className="flex items-center gap-3">
          <LogoSVG size={collapsed ? 36 : 36} />
          {!collapsed && (
            <div className="sidebar-brand-text">
              <div className="font-black text-sm leading-tight tracking-tight">
                <span className="gradient-text">Zero Employee</span>
              </div>
              <div className="text-[11px] text-gray-500 font-medium tracking-wide">STUDIO OS</div>
            </div>
          )}
        </div>
      </div>

      {/* Navigation */}
      <nav className="flex-1 p-3 space-y-1">
        {navItems.map(item => (
          <button
            key={item.id}
            onClick={() => setCurrentPage(item.id)}
            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 group ${
              currentPage === item.id
                ? item.highlight
                  ? 'bg-gradient-to-r from-purple-600/20 to-indigo-600/20 text-purple-300 border border-purple-500/20 shadow-lg shadow-purple-500/5'
                  : 'bg-indigo-600/15 text-indigo-400 border border-indigo-500/20'
                : 'text-gray-400 hover:text-white hover:bg-gray-800/50 border border-transparent'
            }`}
            title={collapsed ? item.label : undefined}
          >
            <Icon name={item.icon} size={18} />
            {!collapsed && <span className="nav-label">{item.label}</span>}
            {!collapsed && item.highlight && (
              <span className="ml-auto text-[10px] bg-purple-500/20 text-purple-300 px-2 py-0.5 rounded-full font-bold border border-purple-500/20">LIVE</span>
            )}
          </button>
        ))}
      </nav>

      {/* Collapse toggle */}
      <div className="px-3 pb-3">
        <button onClick={() => setCollapsed(!collapsed)} className="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-xl text-xs text-gray-500 hover:text-gray-300 hover:bg-gray-800/50 transition-all">
          <Icon name={collapsed ? 'arrowRight' : 'arrowLeft'} size={14} />
          {!collapsed && <span>Collapse</span>}
        </button>
      </div>

      {/* Footer */}
      <div className="p-4 border-t border-gray-800/60">
        <div className="flex items-center gap-2 text-xs text-gray-500 sidebar-footer-text">
          <span className="w-2 h-2 bg-emerald-400 rounded-full animate-pulse" />
          4 agents • 0 employees
        </div>
      </div>
    </aside>
  )
}

/* ═══════════════════════════════════════════════════════════
   DASHBOARD PAGE
   ═══════════════════════════════════════════════════════════ */

function DashboardPage({ setCurrentPage }) {
  const [stats, setStats] = useState(null)
  const [activity, setActivity] = useState([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState(null)

  const loadData = useCallback(async () => {
    setLoading(true)
    setError(null)
    try {
      const [statsRes, actRes] = await Promise.all([
        axios.get(`${API}/dashboard/stats`),
        axios.get(`${API}/dashboard/activity`),
      ])
      setStats(statsRes.data)
      setActivity(actRes.data.activity || [])
    } catch (e) {
      setError('Failed to load dashboard data')
      console.error(e)
    }
    setLoading(false)
  }, [])

  useEffect(() => { loadData() }, [loadData])

  if (loading) return <LoadingState message="Loading dashboard..." />
  if (error) return <ErrorState message={error} onRetry={loadData} />

  const revenueData = [
    { label: 'Revenue', value: stats?.total_revenue || 0, color: 'green', max: Math.max(stats?.total_revenue || 1, 1) },
    { label: 'Costs', value: stats?.estimated_costs || 0, color: 'red', max: Math.max(stats?.total_revenue || 1, 1) },
    { label: 'Profit', value: stats?.estimated_profit || 0, color: 'blue', max: Math.max(stats?.total_revenue || 1, 1) },
  ]

  const agents = [
    { name: 'Intake Agent', desc: 'Analyzes client briefs', status: 'active', model: 'Nemotron 3 Ultra', color: 'blue' },
    { name: 'Pricing Agent', desc: 'Calculates packages & pricing', status: 'active', model: 'Rule-based', color: 'purple' },
    { name: 'Stripe Agent', desc: 'Handles payments', status: 'active', model: 'Stripe API', color: 'green' },
    { name: 'Creative Agent', desc: 'Generates deliverables', status: 'active', model: 'AI Generation', color: 'amber' },
  ]

  return (
    <div className="space-y-6 animate-fadeIn">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <div className="flex items-center gap-3 mb-1">
            <h1 className="text-3xl font-black tracking-tight text-white">Dashboard</h1>
            <span className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-500/15 text-indigo-400 border border-indigo-500/20">v0.1.0</span>
          </div>
          <p className="text-gray-500 text-sm">Overview of your autonomous creative agency</p>
        </div>
        <button
          onClick={() => setCurrentPage('generate')}
          className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold transition-all duration-200 hover:scale-105 shadow-lg shadow-indigo-500/25"
        >
          <Icon name="plus" size={16} />
          New Project
        </button>
      </div>

      {/* Stats Row */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <StatCard
          icon={<Icon name="dollar" size={18} />}
          label="Revenue"
          value={`$${(stats?.total_revenue || 0).toLocaleString()}`}
          color="green"
          sub={`Net: $${(stats?.estimated_profit || 0).toLocaleString()}`}
        />
        <StatCard
          icon={<Icon name="users" size={18} />}
          label="Total Projects"
          value={stats?.total_clients || 0}
          color="blue"
          sub={`${stats?.completed_projects || 0} completed`}
        />
        <StatCard
          icon={<Icon name="chart" size={18} />}
          label="Conversion"
          value={`${(stats?.conversion_rate || 0).toFixed(0)}%`}
          color="purple"
          sub={`${stats?.in_progress || 0} in progress`}
        />
        <StatCard
          icon={<Icon name="sparkles" size={18} />}
          label="Avg. Project Value"
          value={`$${(stats?.avg_project_value || 0).toFixed(0)}`}
          color="amber"
          sub="0 human employees"
        />
      </div>

      {/* Revenue Chart + Activity */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {/* Revenue Breakdown */}
        <div className="lg:col-span-2 glass-card rounded-2xl p-6">
          <div className="flex items-center justify-between mb-6">
            <h3 className="font-bold text-white">Revenue Overview</h3>
            <span className="text-xs text-gray-500">All time</span>
          </div>
          <div className="space-y-5">
            {revenueData.map((item, i) => (
              <div key={i} className="space-y-2">
                <div className="flex items-center justify-between text-sm">
                  <span className="text-gray-400">{item.label}</span>
                  <span className={`font-bold ${item.color === 'green' ? 'text-emerald-400' : item.color === 'red' ? 'text-red-400' : 'text-blue-400'}`}>
                    ${item.value.toLocaleString()}
                  </span>
                </div>
                <ProgressBar
                  percent={item.max > 0 ? (item.value / item.max * 100) : 0}
                  color={item.color === 'red' ? 'red' : item.color}
                  size="md"
                  animated
                />
              </div>
            ))}
          </div>
        </div>

        {/* Recent Activity */}
        <div className="glass-card rounded-2xl p-6">
          <div className="flex items-center justify-between mb-5">
            <h3 className="font-bold text-white">Recent Activity</h3>
            <button onClick={() => setCurrentPage('clients')} className="text-xs text-indigo-400 hover:text-indigo-300 transition-colors">
              View all →
            </button>
          </div>
          {activity.length === 0 ? (
            <div className="text-center py-8">
              <Icon name="activity" size={24} className="text-gray-600 mx-auto mb-3" />
              <p className="text-sm text-gray-500">No activity yet</p>
            </div>
          ) : (
            <div className="space-y-3">
              {activity.slice(0, 5).map((a, i) => (
                <div key={i} className="flex items-center gap-3 p-2.5 rounded-xl hover:bg-gray-800/40 transition-colors group">
                  <div className="w-9 h-9 rounded-lg bg-gradient-to-br from-indigo-500/20 to-purple-500/20 flex items-center justify-center text-indigo-300 text-xs font-bold flex-shrink-0 border border-indigo-500/10">
                    {a.client?.[0] || '?'}
                  </div>
                  <div className="flex-1 min-w-0">
                    <div className="text-sm font-semibold text-gray-200 truncate">{a.client}</div>
                    <div className="text-[11px] text-gray-500">{a.package || 'N/A'}{a.price ? ` — $${a.price}` : ''}</div>
                  </div>
                  <StatusBadge status={a.status} size="xs" />
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      {/* Package Distribution + Agent Status + Quick Actions */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {/* Package Distribution */}
        <div className="glass-card rounded-2xl p-6">
          <h3 className="font-bold text-white mb-5">Packages Sold</h3>
          <div className="space-y-4">
            {Object.entries(stats?.packages_sold || {}).map(([pkg, count]) => (
              <div key={pkg} className="space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-sm text-gray-300">{pkg}</span>
                  <span className="text-sm font-bold text-white">{count}</span>
                </div>
                <ProgressBar
                  percent={stats?.total_clients > 0 ? (count / stats.total_clients * 100) : 0}
                  color="purple"
                  size="sm"
                />
              </div>
            ))}
            {Object.keys(stats?.packages_sold || {}).length === 0 && (
              <p className="text-sm text-gray-500 text-center py-4">No packages sold yet</p>
            )}
          </div>
        </div>

        {/* Agent Status */}
        <div className="glass-card rounded-2xl p-6">
          <h3 className="font-bold text-white mb-5">Agent Status</h3>
          <div className="space-y-3">
            {agents.map(agent => (
              <div key={agent.name} className="flex items-center gap-3 p-2.5 rounded-xl hover:bg-gray-800/40 transition-colors">
                <div className={`w-2 h-2 rounded-full flex-shrink-0 ${agent.status === 'active' ? 'bg-emerald-400 animate-pulse' : 'bg-gray-500'}`} />
                <div className="flex-1 min-w-0">
                  <div className="text-sm font-medium text-gray-200">{agent.name}</div>
                  <div className="text-[11px] text-gray-500">{agent.model}</div>
                </div>
                <StatusBadge status={agent.status} size="xs" />
              </div>
            ))}
          </div>
        </div>

        {/* Quick Actions */}
        <div className="glass-card rounded-2xl p-6">
          <h3 className="font-bold text-white mb-5">Quick Actions</h3>
          <div className="space-y-3">
            <button onClick={() => setCurrentPage('generate')} className="w-full flex items-center gap-3 p-3 rounded-xl bg-indigo-600/10 border border-indigo-500/20 hover:bg-indigo-600/20 transition-all text-left group">
              <div className="p-2 rounded-lg bg-indigo-500/15 text-indigo-400 group-hover:scale-110 transition-transform">
                <Icon name="zap" size={16} />
              </div>
              <div>
                <div className="text-sm font-semibold text-gray-200">New Project</div>
                <div className="text-[11px] text-gray-500">Start a full workflow</div>
              </div>
              <Icon name="arrowRight" size={14} className="ml-auto text-gray-600 group-hover:text-indigo-400 transition-colors" />
            </button>
            <button onClick={() => setCurrentPage('demo')} className="w-full flex items-center gap-3 p-3 rounded-xl bg-purple-600/10 border border-purple-500/20 hover:bg-purple-600/20 transition-all text-left group">
              <div className="p-2 rounded-lg bg-purple-500/15 text-purple-400 group-hover:scale-110 transition-transform">
                <Icon name="demo" size={16} />
              </div>
              <div>
                <div className="text-sm font-semibold text-gray-200">Run Demo</div>
                <div className="text-[11px] text-gray-500">Auto-play the workflow</div>
              </div>
              <Icon name="arrowRight" size={14} className="ml-auto text-gray-600 group-hover:text-purple-400 transition-colors" />
            </button>
            <button onClick={() => setCurrentPage('clients')} className="w-full flex items-center gap-3 p-3 rounded-xl bg-emerald-600/10 border border-emerald-500/20 hover:bg-emerald-600/20 transition-all text-left group">
              <div className="p-2 rounded-lg bg-emerald-500/15 text-emerald-400 group-hover:scale-110 transition-transform">
                <Icon name="clients" size={16} />
              </div>
              <div>
                <div className="text-sm font-semibold text-gray-200">View Clients</div>
                <div className="text-[11px] text-gray-500">Manage client projects</div>
              </div>
              <Icon name="arrowRight" size={14} className="ml-auto text-gray-600 group-hover:text-emerald-400 transition-colors" />
            </button>
          </div>
        </div>
      </div>
    </div>
  )
}

/* ═══════════════════════════════════════════════════════════
   CLIENTS PAGE
   ═══════════════════════════════════════════════════════════ */

function ClientsPage() {
  const [clients, setClients] = useState([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState(null)
  const [search, setSearch] = useState('')
  const [filter, setFilter] = useState('all')
  const [sort, setSort] = useState('newest')
  const [page, setPage] = useState(1)
  const perPage = 8

  const loadClients = useCallback(async () => {
    setLoading(true)
    setError(null)
    try {
      const res = await axios.get(`${API}/clients`)
      setClients(res.data.clients || [])
    } catch (e) {
      setError('Failed to load clients')
    }
    setLoading(false)
  }, [])

  useEffect(() => { loadClients() }, [loadClients])

  const filtered = useMemo(() => {
    let result = [...clients]
    if (search) {
      const q = search.toLowerCase()
      result = result.filter(c =>
        c.client_name?.toLowerCase().includes(q) ||
        c.client_email?.toLowerCase().includes(q) ||
        c.status?.toLowerCase().includes(q)
      )
    }
    if (filter !== 'all') {
      result = result.filter(c => c.status === filter)
    }
    if (sort === 'newest') {
      result.sort((a, b) => new Date(b.created_at) - new Date(a.created_at))
    } else if (sort === 'oldest') {
      result.sort((a, b) => new Date(a.created_at) - new Date(b.created_at))
    } else if (sort === 'name') {
      result.sort((a, b) => a.client_name?.localeCompare(b.client_name))
    } else if (sort === 'price') {
      result.sort((a, b) => (b.pricing?.price || 0) - (a.pricing?.price || 0))
    }
    return result
  }, [clients, search, filter, sort])

  const totalPages = Math.ceil(filtered.length / perPage)
  const paginated = filtered.slice((page - 1) * perPage, page * perPage)

  const statusCounts = useMemo(() => {
    const counts = { all: clients.length }
    clients.forEach(c => { counts[c.status] = (counts[c.status] || 0) + 1 })
    return counts
  }, [clients])

  if (loading) return <LoadingState message="Loading clients..." />
  if (error) return <ErrorState message={error} onRetry={loadClients} />

  return (
    <div className="space-y-6 animate-fadeIn">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-black tracking-tight text-white mb-1">Clients</h1>
          <p className="text-gray-500 text-sm">Manage client briefs and track project status</p>
        </div>
      </div>

      {/* Search + Filters */}
      <div className="glass-card rounded-2xl p-4">
        <div className="flex items-center gap-4 flex-wrap">
          <div className="flex-1 min-w-[200px] relative">
            <Icon name="search" size={16} className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500" />
            <input
              type="text"
              placeholder="Search clients..."
              value={search}
              onChange={e => { setSearch(e.target.value); setPage(1) }}
              className="w-full bg-gray-800/50 border border-gray-700/50 rounded-xl pl-10 pr-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/20 transition-all"
            />
          </div>
          <select
            value={sort}
            onChange={e => setSort(e.target.value)}
            className="bg-gray-800/50 border border-gray-700/50 rounded-xl px-3 py-2.5 text-sm text-gray-300 focus:outline-none focus:border-indigo-500/50 transition-all"
          >
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="name">By name</option>
            <option value="price">By price</option>
          </select>
          <div className="flex gap-1.5">
            {['all', 'completed', 'analyzed', 'priced', 'pending'].map(s => (
              <button
                key={s}
                onClick={() => { setFilter(s); setPage(1) }}
                className={`px-3 py-2 rounded-lg text-xs font-medium transition-all ${
                  filter === s
                    ? 'bg-indigo-600/20 text-indigo-400 border border-indigo-500/30'
                    : 'text-gray-400 hover:text-gray-200 hover:bg-gray-800/50 border border-transparent'
                }`}
              >
                {s.charAt(0).toUpperCase() + s.slice(1)} ({statusCounts[s] || 0})
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Clients Table */}
      {filtered.length === 0 ? (
        <EmptyState
          icon="clients"
          title="No clients yet"
          description="Start by analyzing a client brief in the Generate page"
          actionLabel="Create First Project"
          onAction={() => {}}
        />
      ) : (
        <div className="glass-card rounded-2xl overflow-hidden">
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="text-left border-b border-gray-800/60">
                  <th className="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Client</th>
                  <th className="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Package</th>
                  <th className="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Price</th>
                  <th className="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                  <th className="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Created</th>
                  <th className="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                {paginated.map((c, i) => (
                  <tr key={c.id} className="border-b border-gray-800/30 hover:bg-gray-800/30 transition-colors group" style={{ animationDelay: `${i * 30}ms` }}>
                    <td className="px-6 py-4">
                      <div className="flex items-center gap-3">
                        <div className="w-9 h-9 rounded-lg bg-gradient-to-br from-indigo-500/20 to-purple-500/20 flex items-center justify-center text-indigo-300 text-xs font-bold flex-shrink-0 border border-indigo-500/10">
                          {c.client_name?.[0]?.toUpperCase() || '?'}
                        </div>
                        <div>
                          <div className="font-semibold text-gray-200">{c.client_name}</div>
                          <div className="text-xs text-gray-500">{c.client_email}</div>
                        </div>
                      </div>
                    </td>
                    <td className="px-6 py-4 text-gray-400 text-sm">{c.pricing?.package_name || '—'}</td>
                    <td className="px-6 py-4">
                      <span className="font-bold text-emerald-400 font-mono">{c.pricing?.price ? `$${c.pricing.price}` : '—'}</span>
                    </td>
                    <td className="px-6 py-4"><StatusBadge status={c.status} /></td>
                    <td className="px-6 py-4 text-gray-500 text-xs whitespace-nowrap">{new Date(c.created_at).toLocaleDateString()}</td>
                    <td className="px-6 py-4">
                      <div className="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                        <button className="p-1.5 rounded-lg hover:bg-gray-700/50 text-gray-500 hover:text-gray-300 transition-all" title="View">
                          <Icon name="eye" size={14} />
                        </button>
                        <button className="p-1.5 rounded-lg hover:bg-gray-700/50 text-gray-500 hover:text-gray-300 transition-all" title="Edit">
                          <Icon name="edit" size={14} />
                        </button>
                        <button className="p-1.5 rounded-lg hover:bg-red-500/10 text-gray-500 hover:text-red-400 transition-all" title="Delete">
                          <Icon name="trash" size={14} />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {/* Pagination */}
          {totalPages > 1 && (
            <div className="flex items-center justify-between px-6 py-4 border-t border-gray-800/60">
              <span className="text-xs text-gray-500">
                Showing {(page - 1) * perPage + 1}–{Math.min(page * perPage, filtered.length)} of {filtered.length}
              </span>
              <div className="flex gap-1.5">
                <button
                  onClick={() => setPage(p => Math.max(1, p - 1))}
                  disabled={page === 1}
                  className="px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-800/50 text-gray-400 hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition-all"
                >
                  ← Prev
                </button>
                {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => (
                  <button
                    key={p}
                    onClick={() => setPage(p)}
                    className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                      p === page ? 'bg-indigo-600 text-white' : 'bg-gray-800/50 text-gray-400 hover:text-white'
                    }`}
                  >
                    {p}
                  </button>
                ))}
                <button
                  onClick={() => setPage(p => Math.min(totalPages, p + 1))}
                  disabled={page === totalPages}
                  className="px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-800/50 text-gray-400 hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition-all"
                >
                  Next →
                </button>
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  )
}

/* ═══════════════════════════════════════════════════════════
   GENERATE PAGE
   ═══════════════════════════════════════════════════════════ */

function GeneratePage() {
  const [step, setStep] = useState(0)
  const [brief, setBrief] = useState('')
  const [clientName, setClientName] = useState('')
  const [clientEmail, setClientEmail] = useState('')
  const [intakeData, setIntakeData] = useState(null)
  const [pricingData, setPricingData] = useState(null)
  const [checkoutData, setCheckoutData] = useState(null)
  const [creativeData, setCreativeData] = useState(null)
  const [sessionId, setSessionId] = useState(null)
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState(null)

  const steps = [
    { label: 'Brief', desc: 'Submit project brief', icon: 'edit' },
    { label: 'Analysis', desc: 'AI analyzes requirements', icon: 'search' },
    { label: 'Pricing', desc: 'Calculate package & price', icon: 'dollar' },
    { label: 'Checkout', desc: 'Create payment session', icon: 'creditCard' },
    { label: 'Creative', desc: 'Generate deliverables', icon: 'sparkles' },
    { label: 'Complete', desc: 'Project delivered!', icon: 'check' },
  ]

  const reset = () => {
    setStep(0); setBrief(''); setClientName(''); setClientEmail('')
    setIntakeData(null); setPricingData(null); setCheckoutData(null); setCreativeData(null)
    setSessionId(null); setError(null)
  }

  const runAnalysis = async () => {
    if (!brief.trim()) return
    setLoading(true); setError(null)
    try {
      const res = await axios.post(`${API}/analyze-brief`, { brief, client_name: clientName || 'Client', client_email: clientEmail || 'client@example.com' })
      setIntakeData(res.data); setSessionId(res.data.session_id); setStep(2)
    } catch (e) { setError('Failed to analyze brief. Please try again.') }
    setLoading(false)
  }

  const runPricing = async () => {
    setLoading(true); setError(null)
    try {
      const res = await axios.post(`${API}/calculate-pricing`, { intake_data: intakeData.intake })
      setPricingData(res.data); setStep(3)
    } catch (e) { setError('Failed to calculate pricing.') }
    setLoading(false)
  }

  const runCheckout = async () => {
    setLoading(true); setError(null)
    try {
      const res = await axios.post(`${API}/create-checkout`, {
        client_info: { name: clientName || 'Client', email: clientEmail || 'client@example.com', project_id: sessionId },
        package: pricingData.pricing.package_name, price: pricingData.pricing.price
      })
      await axios.get(`${API}/payment-status/${res.data.checkout.session_id}`)
      setCheckoutData(res.data); setStep(4)
    } catch (e) { setError('Failed to create checkout.') }
    setLoading(false)
  }

  const runCreative = async () => {
    setLoading(true); setError(null)
    try {
      const res = await axios.post(`${API}/generate-creative`, {
        brief, business_type: intakeData.intake.business_type, tone: intakeData.intake.tone
      })
      setCreativeData(res.data); setStep(5)
    } catch (e) { setError('Failed to generate creative package.') }
    setLoading(false)
  }

  return (
    <div className="space-y-6 animate-fadeIn max-w-4xl mx-auto">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-black tracking-tight text-white mb-1">Generate Project</h1>
          <p className="text-gray-500 text-sm">End-to-end autonomous workflow — from brief to delivery</p>
        </div>
        {step > 0 && (
          <button onClick={reset} className="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium bg-gray-800/50 text-gray-400 hover:text-white hover:bg-gray-800 border border-gray-700/50 transition-all">
            <Icon name="refresh" size={14} />
            Start Over
          </button>
        )}
      </div>

      {/* Stepper */}
      <div className="glass-card rounded-2xl p-5">
        <div className="flex items-center justify-between">
          {steps.map((s, i) => (
            <div key={i} className="flex items-center flex-1 last:flex-none">
              <div className="flex flex-col items-center">
                <div className={`w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold transition-all duration-300 ${
                  i < step ? 'bg-emerald-500 text-white shadow-lg shadow-emerald-500/20' :
                  i === step ? 'bg-indigo-600 text-white ring-4 ring-indigo-500/20 shadow-lg shadow-indigo-500/20' :
                  'bg-gray-800/50 text-gray-500 border border-gray-700/50'
                }`}>
                  {i < step ? <Icon name="check" size={16} /> : <span className="text-xs">{i + 1}</span>}
                </div>
                <span className={`text-[11px] mt-2 font-medium hidden sm:block ${i <= step ? 'text-gray-200' : 'text-gray-600'}`}>
                  {s.label}
                </span>
              </div>
              {i < steps.length - 1 && (
                <div className={`flex-1 h-0.5 mx-2 mt-[-18px] sm:mt-0 transition-all duration-500 rounded-full ${
                  i < step ? 'bg-gradient-to-r from-emerald-500 to-emerald-400' : 'bg-gray-700/50'
                }`} />
              )}
            </div>
          ))}
        </div>
      </div>

      {/* Error */}
      {error && (
        <div className="flex items-center gap-3 bg-red-500/10 border border-red-500/20 rounded-xl p-4 text-red-400 text-sm backdrop-blur-sm animate-fadeIn">
          <Icon name="alertCircle" size={16} />
          {error}
        </div>
      )}

      {/* Step 0: Brief Input */}
      {step === 0 && (
        <div className="glass-card rounded-2xl p-6 space-y-5 animate-fadeIn">
          <div className="flex items-center gap-3 mb-1">
            <div className="p-2 rounded-lg bg-indigo-500/15 text-indigo-400">
              <Icon name="edit" size={18} />
            </div>
            <div>
              <h3 className="font-bold text-white">Client Brief</h3>
              <p className="text-xs text-gray-500">Provide details about the client's project</p>
            </div>
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label className="text-xs font-medium text-gray-400 mb-1.5 block">Client Name</label>
              <input className="w-full bg-gray-800/50 border border-gray-700/50 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/20 transition-all"
                placeholder="Mario's Italian Kitchen" value={clientName} onChange={e => setClientName(e.target.value)} />
            </div>
            <div>
              <label className="text-xs font-medium text-gray-400 mb-1.5 block">Email</label>
              <input className="w-full bg-gray-800/50 border border-gray-700/50 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/20 transition-all"
                placeholder="mario@example.com" value={clientEmail} onChange={e => setClientEmail(e.target.value)} />
            </div>
          </div>
          <div>
            <label className="text-xs font-medium text-gray-400 mb-1.5 block">Project Brief</label>
            <textarea className="w-full bg-gray-800/50 border border-gray-700/50 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/20 transition-all resize-none"
              rows={5} placeholder="Describe what the client needs — website, logo, social media, brand identity, etc."
              value={brief} onChange={e => setBrief(e.target.value)} />
            <div className="flex items-center justify-between mt-2">
              <span className="text-xs text-gray-600">{brief.length}/500 characters</span>
              {brief.length > 0 && <span className="text-xs text-emerald-500">✓ Brief provided</span>}
            </div>
          </div>
          <button onClick={() => { setStep(1); runAnalysis() }}
            disabled={!brief.trim() || loading}
            className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition-all duration-200 hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed shadow-lg shadow-indigo-500/25">
            {loading ? <><Icon name="spinner" size={16} /> Analyzing...</> : <>Submit Brief <Icon name="arrowRight" size={16} /></>}
          </button>
        </div>
      )}

      {/* Step 1: Loading */}
      {step === 1 && (
        <div className="glass-card rounded-2xl p-12 text-center animate-fadeIn">
          <div className="w-14 h-14 border-2 border-indigo-500/30 border-t-indigo-500 rounded-full animate-spin mx-auto mb-4" />
          <p className="text-gray-400 font-medium">Intake Agent is analyzing the brief...</p>
          <p className="text-xs text-gray-600 mt-1">Extracting business type, needs, and recommendations</p>
        </div>
      )}

      {/* Step 2: Analysis Result */}
      {step >= 2 && intakeData && (
        <div className="glass-card rounded-2xl p-6 space-y-5 animate-fadeIn">
          <div className="flex items-center gap-3">
            <div className="p-2 rounded-lg bg-emerald-500/15 text-emerald-400">
              <Icon name="check" size={18} />
            </div>
            <div>
              <h3 className="font-bold text-white">Brief Analyzed</h3>
              <p className="text-xs text-gray-500">Intake Agent completed analysis</p>
            </div>
          </div>
          <div className="grid grid-cols-2 lg:grid-cols-3 gap-3">
            {[
              { label: 'Business Type', value: intakeData.intake.business_type, capitalize: true },
              { label: 'Tone', value: intakeData.intake.tone, capitalize: true },
              { label: 'Style', value: intakeData.intake.style_preferences, capitalize: true },
            ].map((item, i) => (
              <div key={i} className="bg-gray-800/40 rounded-xl p-4 border border-gray-700/30">
                <div className="text-[11px] text-gray-500 mb-1 uppercase tracking-wider">{item.label}</div>
                <div className={`font-bold text-sm text-gray-200 ${item.capitalize ? 'capitalize' : ''}`}>{item.value}</div>
              </div>
            ))}
            <div className="bg-gray-800/40 rounded-xl p-4 border border-gray-700/30 col-span-2 lg:col-span-3">
              <div className="text-[11px] text-gray-500 mb-2 uppercase tracking-wider">Needs Detected</div>
              <div className="flex flex-wrap gap-2">
                {intakeData.intake.needs?.map(n => (
                  <span key={n} className="bg-indigo-500/15 text-indigo-300 text-xs px-3 py-1 rounded-full border border-indigo-500/20 capitalize">{n.replace('_', ' ')}</span>
                ))}
              </div>
            </div>
            <div className="bg-indigo-500/10 rounded-xl p-4 border border-indigo-500/20 col-span-2 lg:col-span-3">
              <div className="text-[11px] text-gray-500 mb-1 uppercase tracking-wider">Recommended Package</div>
              <div className="font-black text-lg text-indigo-400">{intakeData.intake.recommended_package}</div>
            </div>
          </div>
          {step === 2 && (
            <button onClick={runPricing} disabled={loading}
              className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition-all duration-200 hover:scale-105 shadow-lg shadow-indigo-500/25 disabled:opacity-50">
              {loading ? 'Calculating...' : <>Calculate Pricing <Icon name="arrowRight" size={16} /></>}
            </button>
          )}
        </div>
      )}

      {/* Step 3: Pricing */}
      {step >= 3 && pricingData && (
        <div className="glass-card rounded-2xl p-6 space-y-5 animate-fadeIn">
          <div className="flex items-center gap-3">
            <div className="p-2 rounded-lg bg-emerald-500/15 text-emerald-400">
              <Icon name="check" size={18} />
            </div>
            <div>
              <h3 className="font-bold text-white">Pricing Calculated</h3>
              <p className="text-xs text-gray-500">Pricing Agent generated optimal offer</p>
            </div>
          </div>
          <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">
            <div className="bg-gray-800/40 rounded-xl p-4 text-center border border-gray-700/30">
              <div className="text-[11px] text-gray-500 mb-1 uppercase tracking-wider">Package</div>
              <div className="font-bold text-sm text-gray-200">{pricingData.pricing.package_name}</div>
            </div>
            <div className="bg-emerald-500/10 rounded-xl p-4 text-center border border-emerald-500/20">
              <div className="text-[11px] text-gray-500 mb-1 uppercase tracking-wider">Price</div>
              <div className="text-2xl font-black text-emerald-400">${pricingData.pricing.price}</div>
            </div>
            <div className="bg-gray-800/40 rounded-xl p-4 text-center border border-gray-700/30">
              <div className="text-[11px] text-gray-500 mb-1 uppercase tracking-wider">Costs</div>
              <div className="text-lg font-bold text-red-400">${pricingData.pricing.total_estimated_cost}</div>
            </div>
            <div className="bg-indigo-500/10 rounded-xl p-4 text-center border border-indigo-500/20">
              <div className="text-[11px] text-gray-500 mb-1 uppercase tracking-wider">Margin</div>
              <div className="text-lg font-bold text-indigo-400">{pricingData.pricing.estimated_margin_percent}%</div>
            </div>
          </div>
          <div className="bg-gray-800/40 rounded-xl p-4 border border-gray-700/30">
            <div className="text-[11px] text-gray-500 mb-2 uppercase tracking-wider">Package Includes</div>
            <div className="flex flex-wrap gap-2">
              {pricingData.pricing.includes?.map((item, i) => (
                <span key={i} className="inline-flex items-center gap-1 bg-gray-700/40 text-gray-300 text-xs px-3 py-1.5 rounded-full">
                  <Icon name="check" size={12} className="text-emerald-400" />
                  {item}
                </span>
              ))}
            </div>
          </div>
          {step === 3 && (
            <button onClick={runCheckout} disabled={loading}
              className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition-all duration-200 hover:scale-105 shadow-lg shadow-indigo-500/25 disabled:opacity-50">
              {loading ? 'Creating checkout...' : <>Create Checkout <Icon name="arrowRight" size={16} /></>}
            </button>
          )}
        </div>
      )}

      {/* Step 4: Checkout */}
      {step >= 4 && checkoutData && (
        <div className="glass-card rounded-2xl p-6 space-y-5 animate-fadeIn">
          <div className="flex items-center gap-3">
            <div className="p-2 rounded-lg bg-emerald-500/15 text-emerald-400">
              <Icon name="check" size={18} />
            </div>
            <div>
              <h3 className="font-bold text-white">Payment Confirmed</h3>
              <p className="text-xs text-gray-500">Stripe Agent processed payment successfully</p>
            </div>
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div className="bg-gray-800/40 rounded-xl p-4 border border-gray-700/30">
              <div className="text-[11px] text-gray-500 mb-1 uppercase tracking-wider">Session ID</div>
              <div className="font-mono text-xs text-gray-400 truncate">{checkoutData.checkout.session_id}</div>
            </div>
            <div className="bg-emerald-500/10 rounded-xl p-4 border border-emerald-500/20 text-center">
              <div className="text-[11px] text-gray-500 mb-1 uppercase tracking-wider">Payment Status</div>
              <div className="font-bold text-emerald-400 flex items-center justify-center gap-2">
                <Icon name="check" size={16} /> PAID
              </div>
            </div>
            <div className="bg-gray-800/40 rounded-xl p-4 border border-gray-700/30 text-center">
              <div className="text-[11px] text-gray-500 mb-1 uppercase tracking-wider">Amount</div>
              <div className="text-xl font-black text-white">${checkoutData.checkout.montant}</div>
            </div>
          </div>
          {step === 4 && (
            <button onClick={runCreative} disabled={loading}
              className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition-all duration-200 hover:scale-105 shadow-lg shadow-indigo-500/25 disabled:opacity-50">
              {loading ? 'Generating creative...' : <>Generate Creative Package <Icon name="arrowRight" size={16} /></>}
            </button>
          )}
        </div>
      )}

      {/* Step 5: Creative & Done */}
      {step >= 5 && creativeData && (
        <div className="space-y-4 animate-fadeIn">
          {/* Completion Banner */}
          <div className="glass-card rounded-2xl p-8 text-center border border-emerald-500/20">
            <div className="w-16 h-16 rounded-2xl bg-emerald-500/15 flex items-center justify-center mx-auto mb-4">
              <Icon name="check" size={32} className="text-emerald-400" />
            </div>
            <h3 className="text-2xl font-black text-white mb-2">Project Complete!</h3>
            <p className="text-gray-400 text-sm">All deliverables have been generated successfully</p>
            <div className="flex items-center justify-center gap-6 mt-6 text-sm">
              <div className="text-center">
                <div className="text-gray-500 text-xs">Total Time</div>
                <div className="font-bold text-white">&lt; 3 seconds</div>
              </div>
              <div className="w-px h-8 bg-gray-700" />
              <div className="text-center">
                <div className="text-gray-500 text-xs">Human Employees</div>
                <div className="font-black text-emerald-400">0</div>
              </div>
              <div className="w-px h-8 bg-gray-700" />
              <div className="text-center">
                <div className="text-gray-500 text-xs">Deliverables</div>
                <div className="font-bold text-white">4 assets</div>
              </div>
            </div>
          </div>

          {/* Creative Deliverables */}
          <div className="glass-card rounded-2xl p-6">
            <h3 className="font-bold text-white mb-5">Creative Deliverables</h3>
            <div className="space-y-4">
              {/* Logo */}
              <div className="bg-gray-800/40 rounded-xl p-5 border border-gray-700/30">
                <div className="flex items-center gap-2 mb-3">
                  <div className="p-1.5 rounded-lg bg-purple-500/15 text-purple-400">
                    <Icon name="sparkles" size={14} />
                  </div>
                  <h4 className="font-bold text-sm text-gray-200">Logo Design</h4>
                </div>
                <p className="text-sm text-gray-400 mb-3">{creativeData.creative.logo?.description}</p>
                <div className="flex gap-2 flex-wrap">
                  {creativeData.creative.logo?.variations?.map((v, i) => (
                    <span key={i} className="text-xs bg-gray-700/40 px-3 py-1 rounded-lg text-gray-300 border border-gray-700/30">{v}</span>
                  ))}
                </div>
              </div>

              {/* Website */}
              <div className="bg-gray-800/40 rounded-xl p-5 border border-gray-700/30">
                <div className="flex items-center gap-2 mb-3">
                  <div className="p-1.5 rounded-lg bg-blue-500/15 text-blue-400">
                    <Icon name="globe" size={14} />
                  </div>
                  <h4 className="font-bold text-sm text-gray-200">Website</h4>
                </div>
                <p className="text-sm text-gray-400 mb-3">{creativeData.creative.website?.description}</p>
                <div className="flex gap-2 flex-wrap">
                  {creativeData.creative.website?.pages?.map((p, i) => (
                    <span key={i} className="text-xs bg-gray-700/40 px-3 py-1 rounded-lg text-gray-300 border border-gray-700/30">{p}</span>
                  ))}
                </div>
              </div>

              {/* Social Media */}
              <div className="bg-gray-800/40 rounded-xl p-5 border border-gray-700/30">
                <div className="flex items-center gap-2 mb-3">
                  <div className="p-1.5 rounded-lg bg-pink-500/15 text-pink-400">
                    <Icon name="activity" size={14} />
                  </div>
                  <h4 className="font-bold text-sm text-gray-200">Social Media ({creativeData.creative.social_media?.posts?.length} posts)</h4>
                </div>
                <div className="space-y-2">
                  {creativeData.creative.social_media?.posts?.map((post, i) => (
                    <div key={i} className="bg-gray-900/40 rounded-lg p-3 text-xs text-gray-300 border border-gray-700/20">{post}</div>
                  ))}
                </div>
              </div>

              {/* Brand Identity */}
              <div className="bg-gray-800/40 rounded-xl p-5 border border-gray-700/30">
                <div className="flex items-center gap-2 mb-3">
                  <div className="p-1.5 rounded-lg bg-amber-500/15 text-amber-400">
                    <Icon name="star" size={14} />
                  </div>
                  <h4 className="font-bold text-sm text-gray-200">Brand Identity</h4>
                </div>
                <div className="flex gap-3 mb-3">
                  {creativeData.creative.brand_identity?.color_palette?.map((color, i) => (
                    <div key={i} className="flex flex-col items-center gap-1.5">
                      <div className="w-10 h-10 rounded-xl border-2 border-gray-600 shadow-lg" style={{ backgroundColor: color }} title={color} />
                      <span className="text-[10px] font-mono text-gray-500">{color}</span>
                    </div>
                  ))}
                </div>
                <p className="text-xs text-gray-400">{creativeData.creative.brand_identity?.guidelines}</p>
              </div>
            </div>
          </div>

          <div className="text-center">
            <button onClick={reset} className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition-all duration-200 hover:scale-105 shadow-lg shadow-indigo-500/25">
              <Icon name="refresh" size={16} />
              Generate Another Project
            </button>
          </div>
        </div>
      )}
    </div>
  )
}

/* ═══════════════════════════════════════════════════════════
   SETTINGS PAGE
   ═══════════════════════════════════════════════════════════ */

function SettingsPage() {
  const [agents, setAgents] = useState([
    { name: 'Intake Agent', desc: 'Analyzes client briefs and extracts requirements', model: 'Nemotron 3 Ultra', active: true, color: 'blue' },
    { name: 'Pricing Agent', desc: 'Calculates optimal packages and pricing', model: 'Rule-based (MVP)', active: true, color: 'purple' },
    { name: 'Stripe Agent', desc: 'Handles payment processing and checkout', model: 'Stripe API (test)', active: true, color: 'green' },
    { name: 'Creative Agent', desc: 'Generates creative deliverables and assets', model: 'AI Generation', active: true, color: 'amber' },
  ])
  const [saved, setSaved] = useState(false)

  const toggleAgent = (index) => {
    setAgents(prev => prev.map((a, i) => i === index ? { ...a, active: !a.active } : a))
  }

  const handleSave = () => {
    setSaved(true)
    setTimeout(() => setSaved(false), 2000)
  }

  return (
    <div className="space-y-6 animate-fadeIn max-w-4xl mx-auto">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-black tracking-tight text-white mb-1">Settings</h1>
          <p className="text-gray-500 text-sm">Configure your autonomous agency</p>
        </div>
        <button onClick={handleSave}
          className={`inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 ${
            saved
              ? 'bg-emerald-600 text-white shadow-lg shadow-emerald-500/25'
              : 'bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-500/25 hover:scale-105'
          }`}>
          {saved ? <><Icon name="check" size={16} /> Saved!</> : <><Icon name="save" size={16} /> Save Changes</>}
        </button>
      </div>

      {/* Agent Configuration */}
      <div className="glass-card rounded-2xl p-6">
        <div className="flex items-center gap-3 mb-5">
          <div className="p-2 rounded-lg bg-indigo-500/15 text-indigo-400">
            <Icon name="zap" size={18} />
          </div>
          <div>
            <h3 className="font-bold text-white">Agent Configuration</h3>
            <p className="text-xs text-gray-500">Toggle agents on/off and configure settings</p>
          </div>
        </div>
        <div className="space-y-3">
          {agents.map((agent, i) => (
            <div key={agent.name} className={`flex items-center gap-4 p-4 rounded-xl border transition-all ${
              agent.active ? 'bg-gray-800/30 border-gray-700/40' : 'bg-gray-800/10 border-gray-700/20 opacity-60'
            }`}>
              <div className={`w-2 h-2 rounded-full flex-shrink-0 ${agent.active ? 'bg-emerald-400 animate-pulse' : 'bg-gray-600'}`} />
              <div className="flex-1 min-w-0">
                <div className="font-semibold text-sm text-gray-200">{agent.name}</div>
                <div className="text-xs text-gray-500 mt-0.5">{agent.desc}</div>
              </div>
              <div className="text-right flex-shrink-0">
                <div className="text-[11px] text-gray-500 font-mono">{agent.model}</div>
              </div>
              <ToggleSwitch active={agent.active} onChange={() => toggleAgent(i)} />
            </div>
          ))}
        </div>
      </div>

      {/* Packages */}
      <div className="glass-card rounded-2xl p-6">
        <div className="flex items-center gap-3 mb-5">
          <div className="p-2 rounded-lg bg-purple-500/15 text-purple-400">
            <Icon name="package" size={18} />
          </div>
          <div>
            <h3 className="font-bold text-white">Packages</h3>
            <p className="text-xs text-gray-500">Available service packages</p>
          </div>
        </div>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="bg-gray-800/30 rounded-xl p-5 border border-indigo-500/20">
            <div className="text-xs font-semibold text-indigo-400 uppercase tracking-wider mb-2">Starter</div>
            <div className="text-3xl font-black text-white mb-3">$299</div>
            <ul className="text-xs text-gray-400 space-y-2">
              <li className="flex items-center gap-2"><Icon name="check" size={12} className="text-emerald-400" /> One-page website</li>
              <li className="flex items-center gap-2"><Icon name="check" size={12} className="text-emerald-400" /> Logo design</li>
              <li className="flex items-center gap-2"><Icon name="check" size={12} className="text-emerald-400" /> 3 social media posts</li>
            </ul>
          </div>
          <div className="bg-gray-800/30 rounded-xl p-5 border border-purple-500/30 relative">
            <div className="absolute -top-2.5 right-4 text-[10px] font-bold bg-purple-500 text-white px-2 py-0.5 rounded-full">POPULAR</div>
            <div className="text-xs font-semibold text-purple-400 uppercase tracking-wider mb-2">Business</div>
            <div className="text-3xl font-black text-white mb-3">$499</div>
            <ul className="text-xs text-gray-400 space-y-2">
              <li className="flex items-center gap-2"><Icon name="check" size={12} className="text-emerald-400" /> Multi-page website</li>
              <li className="flex items-center gap-2"><Icon name="check" size={12} className="text-emerald-400" /> Full brand identity</li>
              <li className="flex items-center gap-2"><Icon name="check" size={12} className="text-emerald-400" /> 10 social media posts</li>
              <li className="flex items-center gap-2"><Icon name="check" size={12} className="text-emerald-400" /> Marketing copy</li>
            </ul>
          </div>
          <div className="bg-gray-800/30 rounded-xl p-5 border border-amber-500/20">
            <div className="text-xs font-semibold text-amber-400 uppercase tracking-wider mb-2">Premium</div>
            <div className="text-3xl font-black text-white mb-3">$999</div>
            <ul className="text-xs text-gray-400 space-y-2">
              <li className="flex items-center gap-2"><Icon name="check" size={12} className="text-emerald-400" /> Everything in Business</li>
              <li className="flex items-center gap-2"><Icon name="check" size={12} className="text-emerald-400" /> Brand guidelines</li>
              <li className="flex items-center gap-2"><Icon name="check" size={12} className="text-emerald-400" /> 20 social media posts</li>
              <li className="flex items-center gap-2"><Icon name="check" size={12} className="text-emerald-400" /> Email templates</li>
              <li className="flex items-center gap-2"><Icon name="check" size={12} className="text-emerald-400" /> Business cards</li>
            </ul>
          </div>
        </div>
      </div>

      {/* System Info */}
      <div className="glass-card rounded-2xl p-6">
        <div className="flex items-center gap-3 mb-5">
          <div className="p-2 rounded-lg bg-cyan-500/15 text-cyan-400">
            <Icon name="info" size={18} />
          </div>
          <div>
            <h3 className="font-bold text-white">System Info</h3>
            <p className="text-xs text-gray-500">Platform status and information</p>
          </div>
        </div>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
          {[
            { label: 'Backend', value: 'FastAPI v0.3.0', color: 'emerald' },
            { label: 'Frontend', value: 'React + Vite', color: 'blue' },
            { label: 'Python', value: '3.14', color: 'amber' },
            { label: 'Employees', value: '0', color: 'emerald', highlight: true },
          ].map((item, i) => (
            <div key={i} className="bg-gray-800/30 rounded-xl p-4 border border-gray-700/30">
              <div className="text-[11px] text-gray-500 uppercase tracking-wider mb-1">{item.label}</div>
              <div className={`font-bold text-sm ${item.highlight ? 'text-emerald-400' : 'text-gray-200'}`}>{item.value}</div>
            </div>
          ))}
        </div>
      </div>

      {/* API Keys */}
      <div className="glass-card rounded-2xl p-6">
        <div className="flex items-center gap-3 mb-5">
          <div className="p-2 rounded-lg bg-amber-500/15 text-amber-400">
            <Icon name="key" size={18} />
          </div>
          <div>
            <h3 className="font-bold text-white">API Keys</h3>
            <p className="text-xs text-gray-500">Configure external service integrations</p>
          </div>
        </div>
        <div className="space-y-3">
          {[
            { name: 'Stripe API Key', placeholder: 'sk_test_...', status: 'active' },
            { name: 'OpenRouter API Key', placeholder: 'sk-or-...', status: 'active' },
            { name: 'Webhook Secret', placeholder: 'whsec_...', status: 'active' },
          ].map((key, i) => (
            <div key={i} className="flex items-center gap-3 p-3 bg-gray-800/30 rounded-xl border border-gray-700/30">
              <div className="flex-1">
                <div className="text-sm font-medium text-gray-200">{key.name}</div>
                <input type="password" placeholder={key.placeholder}
                  className="w-full bg-transparent text-xs text-gray-400 mt-1 focus:outline-none font-mono" />
              </div>
              <StatusBadge status={key.status} size="xs" />
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

/* ═══════════════════════════════════════════════════════════
   MAIN APP
   ═══════════════════════════════════════════════════════════ */

function App() {
  const [currentPage, setCurrentPage] = useState('dashboard')
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false)
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false)

  const renderPage = () => {
    switch (currentPage) {
      case 'dashboard': return <DashboardPage setCurrentPage={setCurrentPage} />
      case 'clients': return <ClientsPage />
      case 'generate': return <GeneratePage />
      case 'demo': return <DemoPage />
      case 'settings': return <SettingsPage />
      default: return <DashboardPage setCurrentPage={setCurrentPage} />
    }
  }

  return (
    <div className="min-h-screen bg-[#030712] text-white flex">
      {/* Ambient Background */}
      <div className="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div className="absolute top-0 left-1/4 w-[500px] h-[500px] bg-indigo-500/[0.03] rounded-full blur-[120px]" />
        <div className="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-purple-500/[0.03] rounded-full blur-[120px]" />
        <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-pink-500/[0.02] rounded-full blur-[100px]" />
      </div>

      {/* Mobile Menu Toggle */}
      <button
        onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
        className="lg:hidden fixed top-4 left-4 z-50 p-2 rounded-xl bg-gray-900/90 border border-gray-800 backdrop-blur-xl"
      >
        <Icon name={mobileMenuOpen ? 'x' : 'menu'} size={20} />
      </button>

      {/* Sidebar */}
      <div className={`${mobileMenuOpen ? 'translate-x-0' : '-translate-x-full'} lg:translate-x-0 fixed lg:sticky top-0 left-0 z-40 transition-transform duration-300`}>
        <Sidebar currentPage={currentPage} setCurrentPage={(p) => { setCurrentPage(p); setMobileMenuOpen(false) }} collapsed={sidebarCollapsed} setCollapsed={setSidebarCollapsed} />
      </div>

      {/* Mobile Overlay */}
      {mobileMenuOpen && (
        <div className="lg:hidden fixed inset-0 bg-black/50 z-30 backdrop-blur-sm" onClick={() => setMobileMenuOpen(false)} />
      )}

      {/* Main Content */}
      <main className="flex-1 overflow-y-auto relative z-10 min-h-screen">
        <div className="p-6 lg:p-8 max-w-7xl mx-auto">
          {renderPage()}
        </div>
      </main>
    </div>
  )
}

export default App
