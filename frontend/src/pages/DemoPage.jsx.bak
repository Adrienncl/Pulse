import { useState, useEffect, useCallback } from 'react'
import axios from 'axios'

const API = '/api'

// ─── Icons ─────────────────────────────────────────────────
const StepIcons = {
  brief: (
    <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
  ),
  analyze: (
    <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  ),
  price: (
    <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  ),
  payment: (
    <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
    </svg>
  ),
  creative: (
    <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
    </svg>
  ),
  deliver: (
    <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
    </svg>
  ),
  spinner: (
    <svg className="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
      <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"/>
      <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
    </svg>
  ),
}

// ─── Demo Brief (pre-filled) ──────────────────────────────
const DEMO_BRIEF = `Boulangerie Martin — Nouvelle boulangerie artisanale qui veut attirer une clientèle jeune et branchée. Nous créons du pain au levain naturel et des viennoiseries bio. Notre slogan : "Le goût du vrai". Nous avons besoin d'une présence digitale complète pour l'ouverture dans 3 semaines : un site web moderne, un logo authentique, des posts Instagram et une identité visuelle cohérente.`

// ─── Step Component ────────────────────────────────────────
function DemoStep({ number, title, subtitle, icon, status, children }) {
  const statusStyles = {
    pending: 'border-gray-700/50 bg-gray-800/30',
    active: 'border-blue-500/50 bg-blue-500/5 shadow-lg shadow-blue-500/10',
    done: 'border-green-500/50 bg-green-500/5',
    error: 'border-red-500/50 bg-red-500/5',
  }

  const badgeStyles = {
    pending: 'bg-gray-700 text-gray-400',
    active: 'bg-blue-500/20 text-blue-400 animate-pulse',
    done: 'bg-green-500/20 text-green-400',
    error: 'bg-red-500/20 text-red-400',
  }

  return (
    <div className={`border rounded-2xl p-6 transition-all duration-500 ${statusStyles[status]}`}>
      <div className="flex items-start gap-4">
        <div className={`flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center transition-all ${
          status === 'done' ? 'bg-green-500/20 text-green-400' :
          status === 'active' ? 'bg-blue-500/20 text-blue-400' :
          'bg-gray-700/50 text-gray-500'
        }`}>
          {status === 'done' ? (
            <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
            </svg>
          ) : status === 'active' ? StepIcons.spinner : icon}
        </div>
        <div className="flex-1 min-w-0">
          <div className="flex items-center gap-3 mb-1">
            <span className="text-xs font-mono text-gray-500">STEP {number}</span>
            <span className={`text-xs px-2 py-0.5 rounded-full font-medium ${badgeStyles[status]}`}>
              {status.toUpperCase()}
            </span>
          </div>
          <h3 className="text-lg font-bold">{title}</h3>
          <p className="text-sm text-gray-400 mb-4">{subtitle}</p>
          {children}
        </div>
      </div>
    </div>
  )
}

// ─── Animated Counter ──────────────────────────────────────
function AnimatedCounter({ value, prefix = '', suffix = '', duration = 1000 }) {
  const [display, setDisplay] = useState(0)
  useEffect(() => {
    let start = 0
    const end = typeof value === 'number' ? value : parseFloat(value) || 0
    if (end === 0) { setDisplay(0); return }
    const step = end / (duration / 16)
    const timer = setInterval(() => {
      start += step
      if (start >= end) { setDisplay(end); clearInterval(timer) }
      else setDisplay(Math.floor(start * 100) / 100)
    }, 16)
    return () => clearInterval(timer)
  }, [value, duration])
  return <span>{prefix}{typeof display === 'number' && display % 1 !== 0 ? display.toFixed(1) : Math.floor(display)}{suffix}</span>
}

// ─── Main Demo Page ────────────────────────────────────────
export default function DemoPage() {
  const [currentStep, setCurrentStep] = useState(0) // 0=brief, 1=analyze, 2=price, 3=checkout, 4=creative, 5=deliver
  const [loading, setLoading] = useState(false)
  const [autoMode, setAutoMode] = useState(false)
  const [autoSpeed, setAutoSpeed] = useState(2000) // ms between steps

  // Data states
  const [briefText, setBriefText] = useState(DEMO_BRIEF)
  const [clientName, setClientName] = useState('Boulangerie Martin')
  const [intakeData, setIntakeData] = useState(null)
  const [pricingData, setPricingData] = useState(null)
  const [checkoutData, setCheckoutData] = useState(null)
  const [creativeData, setCreativeData] = useState(null)
  const [sessionId, setSessionId] = useState(null)
  const [error, setError] = useState(null)

  const steps = [
    { title: 'Brief Client', subtitle: 'Le client soumet son projet', icon: StepIcons.brief },
    { title: 'Analyse IA', subtitle: 'L\'Intake Agent analyse les besoins', icon: StepIcons.analyze },
    { title: 'Pricing Intelligent', subtitle: 'Le Pricing Agent calcule l\'offre', icon: StepIcons.price },
    { title: 'Paiement Stripe', subtitle: 'Le Stripe Agent gère le checkout', icon: StepIcons.payment },
    { title: 'Production Créative', subtitle: 'Le Creative Agent produit les livrables', icon: StepIcons.creative },
    { title: 'Livraison', subtitle: 'Le projet est livré au client', icon: StepIcons.deliver },
  ]

  const reset = () => {
    setCurrentStep(0)
    setLoading(false)
    setAutoMode(false)
    setIntakeData(null)
    setPricingData(null)
    setCheckoutData(null)
    setCreativeData(null)
    setSessionId(null)
    setError(null)
  }

  const loadExampleBrief = () => {
    setBriefText(DEMO_BRIEF)
    setClientName('Boulangerie Martin')
  }

  // ─── Agent Actions ─────────────────────────────────────
  const runAnalysis = async () => {
    setLoading(true)
    setError(null)
    try {
      const res = await axios.post(`${API}/analyze-brief`, {
        brief: briefText,
        client_name: clientName,
        client_email: 'demo@boulangerie-martin.fr'
      })
      setIntakeData(res.data)
      setSessionId(res.data.session_id)
      setCurrentStep(2)
      return true
    } catch (e) {
      setError('Échec de l\'analyse du brief')
      return false
    } finally { setLoading(false) }
  }

  const runPricing = async () => {
    setLoading(true)
    setError(null)
    try {
      const res = await axios.post(`${API}/calculate-pricing`, {
        intake_data: intakeData.intake
      })
      setPricingData(res.data)
      setCurrentStep(3)
      return true
    } catch (e) {
      setError('Échec du calcul du pricing')
      return false
    } finally { setLoading(false) }
  }

  const runCheckout = async () => {
    setLoading(true)
    setError(null)
    try {
      const res = await axios.post(`${API}/create-checkout`, {
        client_info: { name: clientName, email: 'demo@boulangerie-martin.fr', project_id: sessionId },
        package: pricingData.pricing.package_name,
        price: pricingData.pricing.price
      })
      // Auto-complete payment
      await axios.get(`${API}/payment-status/${res.data.checkout.session_id}`)
      setCheckoutData(res.data)
      setCurrentStep(4)
      return true
    } catch (e) {
      setError('Échec de la création du checkout')
      return false
    } finally { setLoading(false) }
  }

  const runCreative = async () => {
    setLoading(true)
    setError(null)
    try {
      const res = await axios.post(`${API}/generate-creative`, {
        brief: briefText,
        business_type: intakeData.intake.business_type,
        tone: intakeData.intake.tone
      })
      setCreativeData(res.data)
      setCurrentStep(5)
      return true
    } catch (e) {
      setError('Échec de la génération créative')
      return false
    } finally { setLoading(false) }
  }

  // ─── Auto Mode ─────────────────────────────────────────
  const runAutoMode = useCallback(async () => {
    setAutoMode(true)
    setCurrentStep(1)
    // Step 1: Analyze
    await new Promise(r => setTimeout(r, autoSpeed))
    const analyzed = await runAnalysis()
    if (!analyzed) { setAutoMode(false); return }
    // Step 2: Pricing
    await new Promise(r => setTimeout(r, autoSpeed))
    const priced = await runPricing()
    if (!priced) { setAutoMode(false); return }
    // Step 3: Checkout
    await new Promise(r => setTimeout(r, autoSpeed))
    const checked = await runCheckout()
    if (!checked) { setAutoMode(false); return }
    // Step 4: Creative
    await new Promise(r => setTimeout(r, autoSpeed))
    const created = await runCreative()
    setAutoMode(false)
  }, [autoSpeed, briefText, clientName, intakeData, pricingData, sessionId])

  // ─── Render ────────────────────────────────────────────
  return (
    <div className="space-y-8 max-w-4xl mx-auto">
      {/* Header */}
      <div className="text-center">
        <div className="inline-flex items-center gap-2 bg-gradient-to-r from-blue-500/20 to-purple-500/20 border border-blue-500/30 rounded-full px-4 py-1.5 mb-4">
          <span className="w-2 h-2 bg-green-400 rounded-full animate-pulse" />
          <span className="text-xs font-medium text-blue-300">MODE DÉMO — Workflow Complet</span>
        </div>
        <h1 className="text-3xl font-black mb-2">
          <span className="bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
            Zero Employee Studio
          </span>
        </h1>
        <p className="text-gray-400">Brief → Analyse → Pricing → Paiement → Production → Livraison</p>
      </div>

      {/* Controls */}
      <div className="flex items-center justify-center gap-4">
        <button
          onClick={reset}
          className="px-5 py-2.5 rounded-xl text-sm font-medium bg-gray-800 hover:bg-gray-700 border border-gray-700 transition-all hover:scale-105"
        >
          🔄 Reset
        </button>
        <button
          onClick={loadExampleBrief}
          className="px-5 py-2.5 rounded-xl text-sm font-medium bg-gray-800 hover:bg-gray-700 border border-gray-700 transition-all hover:scale-105"
        >
          📋 Brief Exemple
        </button>
        <button
          onClick={runAutoMode}
          disabled={autoMode || currentStep !== 0}
          className={`px-6 py-2.5 rounded-xl text-sm font-bold transition-all ${
            autoMode
              ? 'bg-purple-600/50 text-purple-300 cursor-not-allowed'
              : 'bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white shadow-lg shadow-purple-500/25 hover:scale-105'
          }`}
        >
          {autoMode ? '⚡ Workflow en cours...' : '▶ Lancer le Workflow Complet'}
        </button>
        <div className="flex items-center gap-2 text-xs text-gray-500">
          <span>Vitesse:</span>
          <select
            value={autoSpeed}
            onChange={e => setAutoSpeed(Number(e.target.value))}
            className="bg-gray-800 border border-gray-700 rounded-lg px-2 py-1 text-xs"
          >
            <option value={1000}>Rapide (1s)</option>
            <option value={2000}>Normal (2s)</option>
            <option value={3000}>Lent (3s)</option>
          </select>
        </div>
      </div>

      {/* Error */}
      {error && (
        <div className="bg-red-500/10 border border-red-500/30 rounded-xl p-4 text-red-400 text-sm text-center">
          ⚠️ {error}
        </div>
      )}

      {/* Steps */}
      <div className="space-y-4">
        {/* Step 1: Brief */}
        <DemoStep number={1} title="Brief Client" subtitle="Le client soumet son projet" icon={StepIcons.brief}
          status={currentStep === 0 ? 'active' : currentStep > 0 ? 'done' : 'pending'}>
          {currentStep === 0 ? (
            <div className="space-y-4">
              <div>
                <label className="text-sm text-gray-400 mb-1 block">Nom du client</label>
                <input
                  className="w-full bg-gray-700/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/50 transition-all"
                  placeholder="Boulangerie Martin"
                  value={clientName}
                  onChange={e => setClientName(e.target.value)}
                />
              </div>
              <div>
                <label className="text-sm text-gray-400 mb-1 block">Description du projet</label>
                <textarea
                  className="w-full bg-gray-700/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/50 transition-all"
                  rows={4}
                  placeholder="Décrivez le projet du client..."
                  value={briefText}
                  onChange={e => setBriefText(e.target.value)}
                />
              </div>
              <button
                onClick={() => { setCurrentStep(1); runAnalysis() }}
                disabled={!briefText.trim() || loading}
                className="bg-blue-600 hover:bg-blue-500 px-6 py-3 rounded-xl font-semibold text-sm transition-all hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Soumettre le Brief →
              </button>
            </div>
          ) : (
            <div className="bg-green-500/10 rounded-xl p-3 text-sm text-green-300">
              ✅ Brief soumis : "{briefText.substring(0, 80)}..."
            </div>
          )}
        </DemoStep>

        {/* Step 2: Analysis */}
        <DemoStep number={2} title="Analyse IA" subtitle="L'Intake Agent analyse les besoins" icon={StepIcons.analyze}
          status={currentStep < 1 ? 'pending' : currentStep === 1 ? 'active' : currentStep > 1 ? 'done' : 'pending'}>
          {currentStep >= 2 && intakeData ? (
            <div className="grid grid-cols-2 lg:grid-cols-3 gap-3">
              <div className="bg-gray-700/30 rounded-xl p-3">
                <div className="text-xs text-gray-500 mb-1">Type d'activité</div>
                <div className="font-bold capitalize">{intakeData.intake.business_type}</div>
              </div>
              <div className="bg-gray-700/30 rounded-xl p-3">
                <div className="text-xs text-gray-500 mb-1">Ton</div>
                <div className="font-bold capitalize">{intakeData.intake.tone}</div>
              </div>
              <div className="bg-gray-700/30 rounded-xl p-3">
                <div className="text-xs text-gray-500 mb-1">Package recommandé</div>
                <div className="font-bold text-blue-400 text-sm">{intakeData.intake.recommended_package}</div>
              </div>
              <div className="bg-gray-700/30 rounded-xl p-3 col-span-2 lg:col-span-3">
                <div className="text-xs text-gray-500 mb-2">Besoins détectés</div>
                <div className="flex flex-wrap gap-2">
                  {intakeData.intake.needs?.map(n => (
                    <span key={n} className="bg-blue-500/20 text-blue-300 text-xs px-3 py-1 rounded-full">{n.replace('_', ' ')}</span>
                  ))}
                </div>
              </div>
            </div>
          ) : currentStep === 1 ? (
            <div className="text-center py-6 text-gray-400 text-sm">
              {StepIcons.spinner} <span className="ml-2">L'agent analyse le brief...</span>
            </div>
          ) : null}
        </DemoStep>

        {/* Step 3: Pricing */}
        <DemoStep number={3} title="Pricing Intelligent" subtitle="Le Pricing Agent calcule l'offre" icon={StepIcons.price}
          status={currentStep < 2 ? 'pending' : currentStep === 2 ? 'active' : currentStep > 2 ? 'done' : 'pending'}>
          {currentStep >= 3 && pricingData ? (
            <div className="space-y-4">
              <div className="grid grid-cols-4 gap-3">
                <div className="bg-gray-700/30 rounded-xl p-3 text-center">
                  <div className="text-xs text-gray-500 mb-1">Package</div>
                  <div className="font-semibold text-xs">{pricingData.pricing.package_name}</div>
                </div>
                <div className="bg-green-500/10 rounded-xl p-3 text-center border border-green-500/30">
                  <div className="text-xs text-gray-500 mb-1">Prix</div>
                  <div className="text-2xl font-black text-green-400">${pricingData.pricing.price}</div>
                </div>
                <div className="bg-gray-700/30 rounded-xl p-3 text-center">
                  <div className="text-xs text-gray-500 mb-1">Coûts</div>
                  <div className="text-lg font-bold text-red-400">${pricingData.pricing.total_estimated_cost}</div>
                </div>
                <div className="bg-blue-500/10 rounded-xl p-3 text-center border border-blue-500/30">
                  <div className="text-xs text-gray-500 mb-1">Marge</div>
                  <div className="text-lg font-bold text-blue-400">{pricingData.pricing.estimated_margin_percent}%</div>
                </div>
              </div>
              <div className="flex flex-wrap gap-2">
                {pricingData.pricing.includes?.map((item, i) => (
                  <span key={i} className="bg-gray-700/50 text-gray-300 text-xs px-3 py-1.5 rounded-full">✓ {item}</span>
                ))}
              </div>
            </div>
          ) : currentStep === 2 ? (
            <div className="text-center py-6 text-gray-400 text-sm">
              {StepIcons.spinner} <span className="ml-2">Calcul en cours...</span>
            </div>
          ) : null}
        </DemoStep>

        {/* Step 4: Checkout */}
        <DemoStep number={4} title="Paiement Stripe" subtitle="Le Stripe Agent gère le checkout" icon={StepIcons.payment}
          status={currentStep < 3 ? 'pending' : currentStep === 3 ? 'active' : currentStep > 3 ? 'done' : 'pending'}>
          {currentStep >= 4 && checkoutData ? (
            <div className="grid grid-cols-3 gap-3">
              <div className="bg-gray-700/30 rounded-xl p-3">
                <div className="text-xs text-gray-500 mb-1">Session ID</div>
                <div className="font-mono text-xs text-gray-400 truncate">{checkoutData.checkout.session_id}</div>
              </div>
              <div className="bg-green-500/10 rounded-xl p-3 border border-green-500/30 text-center">
                <div className="text-xs text-gray-500 mb-1">Statut</div>
                <div className="font-bold text-green-400">✅ PAID</div>
              </div>
              <div className="bg-gray-700/30 rounded-xl p-3 text-center">
                <div className="text-xs text-gray-500 mb-1">Montant</div>
                <div className="text-xl font-black">${checkoutData.checkout.montant}</div>
              </div>
            </div>
          ) : currentStep === 3 ? (
            <div className="text-center py-6 text-gray-400 text-sm">
              {StepIcons.spinner} <span className="ml-2">Création de la session Stripe...</span>
            </div>
          ) : null}
        </DemoStep>

        {/* Step 5: Creative */}
        <DemoStep number={5} title="Production Créative" subtitle="Le Creative Agent produit les livrables" icon={StepIcons.creative}
          status={currentStep < 4 ? 'pending' : currentStep === 4 ? 'active' : currentStep > 4 ? 'done' : 'pending'}>
          {currentStep >= 5 && creativeData ? (
            <div className="space-y-4">
              {/* Logo */}
              <div className="bg-gray-700/30 rounded-xl p-4">
                <div className="flex items-center gap-2 mb-2">
                  <span className="text-lg">🎨</span>
                  <span className="font-bold text-sm">Logo Design</span>
                </div>
                <p className="text-xs text-gray-400 mb-2">{creativeData.creative.logo?.description}</p>
                <div className="flex gap-2 flex-wrap">
                  {creativeData.creative.logo?.variations?.map((v, i) => (
                    <span key={i} className="bg-gray-600/50 text-xs px-2 py-1 rounded-lg">{v}</span>
                  ))}
                </div>
              </div>
              {/* Website */}
              <div className="bg-gray-700/30 rounded-xl p-4">
                <div className="flex items-center gap-2 mb-2">
                  <span className="text-lg">🌐</span>
                  <span className="font-bold text-sm">Site Web</span>
                </div>
                <p className="text-xs text-gray-400">{creativeData.creative.website?.description}</p>
              </div>
              {/* Social Media */}
              <div className="bg-gray-700/30 rounded-xl p-4">
                <div className="flex items-center gap-2 mb-2">
                  <span className="text-lg">📱</span>
                  <span className="font-bold text-sm">Social Media ({creativeData.creative.social_media?.posts?.length} posts)</span>
                </div>
                <div className="space-y-2">
                  {creativeData.creative.social_media?.posts?.map((post, i) => (
                    <div key={i} className="bg-gray-800/50 rounded-lg p-2.5 text-xs text-gray-300">{post}</div>
                  ))}
                </div>
              </div>
              {/* Brand Identity */}
              <div className="bg-gray-700/30 rounded-xl p-4">
                <div className="flex items-center gap-2 mb-2">
                  <span className="text-lg">🎯</span>
                  <span className="font-bold text-sm">Brand Identity</span>
                </div>
                <div className="flex gap-3 mb-2">
                  {creativeData.creative.brand_identity?.color_palette?.map((color, i) => (
                    <div key={i} className="flex flex-col items-center gap-1">
                      <div className="w-10 h-10 rounded-xl border-2 border-gray-600 shadow-lg" style={{ backgroundColor: color }} />
                      <span className="text-[10px] font-mono text-gray-500">{color}</span>
                    </div>
                  ))}
                </div>
                <p className="text-xs text-gray-400">{creativeData.creative.brand_identity?.guidelines}</p>
              </div>
            </div>
          ) : currentStep === 4 ? (
            <div className="text-center py-6 text-gray-400 text-sm">
              {StepIcons.spinner} <span className="ml-2">Génération des livrables créatifs...</span>
            </div>
          ) : null}
        </DemoStep>

        {/* Step 6: Delivery */}
        <DemoStep number={6} title="Livraison Finale" subtitle="Le projet est livré au client" icon={StepIcons.deliver}
          status={currentStep < 5 ? 'pending' : 'done'}>
          {currentStep >= 5 && (
            <div className="text-center py-6">
              <div className="text-6xl mb-4">🎉</div>
              <h3 className="text-2xl font-black mb-2 bg-gradient-to-r from-green-400 to-emerald-400 bg-clip-text text-transparent">
                Projet Livré !
              </h3>
              <p className="text-gray-400 mb-4">
                Le package créatif complet pour <strong className="text-white">{clientName}</strong> est prêt.
              </p>
              <div className="flex justify-center gap-3">
                {[
                  { label: 'Logo', emoji: '🎨' },
                  { label: 'Site Web', emoji: '🌐' },
                  { label: 'Social Media', emoji: '📱' },
                  { label: 'Brand Identity', emoji: '🎯' },
                ].map(item => (
                  <div key={item.label} className="bg-gray-700/30 rounded-xl px-4 py-2 text-sm">
                    <span className="mr-1">{item.emoji}</span> {item.label}
                  </div>
                ))}
              </div>
              <div className="mt-6 inline-flex items-center gap-2 bg-green-500/10 border border-green-500/30 rounded-full px-5 py-2">
                <span className="text-green-400 font-bold">Zéro employé</span>
                <span className="text-gray-500">•</span>
                <span className="text-gray-400">4 agents IA</span>
                <span className="text-gray-500">•</span>
                <span className="text-gray-400">Livré en quelques secondes</span>
              </div>
            </div>
          )}
        </DemoStep>
      </div>

      {/* Stats Footer */}
      {currentStep >= 5 && pricingData && creativeData && (
        <div className="grid grid-cols-4 gap-4 mt-8">
          {[
            { label: 'Prix', value: `$${pricingData.pricing.price}`, color: 'text-green-400' },
            { label: 'Marge', value: `${pricingData.pricing.estimated_margin_percent}%`, color: 'text-blue-400' },
            { label: 'Employés', value: '0', color: 'text-purple-400' },
            { label: 'Agents', value: '4', color: 'text-cyan-400' },
          ].map(stat => (
            <div key={stat.label} className="bg-gray-800/50 border border-gray-700/50 rounded-xl p-4 text-center">
              <div className="text-xs text-gray-500 mb-1">{stat.label}</div>
              <div className={`text-2xl font-black ${stat.color}`}>{stat.value}</div>
            </div>
          ))}
        </div>
      )}
    </div>
  )
}
