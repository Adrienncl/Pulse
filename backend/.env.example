# ─── RankFix AI — Environment Configuration ─────────────────
# Copy this file to .env and fill in your keys.
#   cp .env.example .env

# ─── Stripe API Keys (Mode Test) ────────────────────────────
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Test card: 4242 4242 4242 4242, expiry: 12/34, CVC: 123
#
# IMPORTANT: Without valid keys, the app runs in SIMULATED mode
# (auto-marks payments as "paid" for demo purposes).
# Replace these with your real Stripe test keys for live checkout.
STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key

# ─── Stripe Webhook ─────────────────────────────────────────
# For production: set up a Stripe webhook pointing to:
#   POST /api/rankfix/stripe-webhook
# Get the signing secret from Stripe Dashboard → Webhooks.
# In simulated mode, webhooks are accepted without verification.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# ─── Hermes Configuration ───────────────────────────────────
# Hermes Dashboard API (for webhook triggering)
ZES_API_URL=http://localhost:9119
ZES_API_KEY=your_hermes_dashboard_token_here
